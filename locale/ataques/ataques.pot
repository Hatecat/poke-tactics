#. nombre
#: data/moves/absorb.tres
msgid "Absorber"
msgstr ""

#. descripción
#: data/moves/absorb.tres
#: data/moves/gigadrain.tres
#: data/moves/megadrain.tres
msgid "Un ataque que absorbe nutrientes. Quien lo usa recupera la mitad de los PS del daño que produce."
msgstr ""

#. nombre
#: data/moves/acid.tres
msgid "Ácido"
msgstr ""

#. descripción
#: data/moves/acid.tres
msgid "Rocía a los enemigos con un ácido corrosivo. Puede bajar la Defensa Especial."
msgstr ""

#. nombre
#: data/moves/acidarmor.tres
msgid "Armadura Ácida"
msgstr ""

#. descripción
#: data/moves/acidarmor.tres
msgid "Transforma la estructura celular para hacerse líquido y aumenta mucho la Defensa."
msgstr ""

#. nombre
#: data/moves/acidspray.tres
msgid "Bomba Ácida"
msgstr ""

#. descripción
#: data/moves/acidspray.tres
msgid "Ataca con un líquido corrosivo que reduce mucho la Defensa Especial del objetivo."
msgstr ""

#. nombre
#: data/moves/acrobatics.tres
msgid "Acróbata"
msgstr ""

#. descripción
#: data/moves/acrobatics.tres
msgid "Golpea ágilmente. Si el usuario no porta ningún objeto, el objetivo resulta seriamente dañado."
msgstr ""

#. nombre
#: data/moves/aerialace.tres
msgid "Golpe Aéreo"
msgstr ""

#. descripción
#: data/moves/aerialace.tres
msgid "El usuario lanza un ataque muy rápido e ineludible."
msgstr ""

#. nombre
#: data/moves/agility.tres
msgid "Agilidad"
msgstr ""

#. descripción
#: data/moves/agility.tres
msgid "Relaja el cuerpo para ganar mucha Velocidad."
msgstr ""

#. nombre
#: data/moves/aircutter.tres
msgid "Aire Afilado"
msgstr ""

#. descripción
#: data/moves/aircutter.tres
msgid "Viento cortante que azota. Suele ser un golpe crítico."
msgstr ""

#. nombre
#: data/moves/airslash.tres
msgid "Tajo Aéreo"
msgstr ""

#. descripción
#: data/moves/airslash.tres
msgid "Ataca con un viento afilado que incluso corta el aire. También puede amedrentar al objetivo."
msgstr ""

#. nombre
#: data/moves/alluringvoice.tres
msgid "Canto Encantador"
msgstr ""

#. nombre
#: data/moves/amnesia.tres
msgid "Amnesia"
msgstr ""

#. descripción
#: data/moves/amnesia.tres
msgid "El usuario olvida sus preocupaciones y aumenta mucho la Defensa Especial."
msgstr ""

#. nombre
#: data/moves/ancientpower.tres
msgid "Poder Pasado"
msgstr ""

#. descripción
#: data/moves/ancientpower.tres
msgid "Ataque prehistórico que puede subir todas las características."
msgstr ""

#. nombre
#: data/moves/aquajet.tres
msgid "Acua Jet"
msgstr ""

#. descripción
#: data/moves/aquajet.tres
msgid "Ataque de una rapidez espeluznante. Este movimiento tiene prioridad alta."
msgstr ""

#. nombre
#: data/moves/aquaring.tres
msgid "Acua Aro"
msgstr ""

#. descripción
#: data/moves/aquaring.tres
msgid "Un manto de agua cubre al Pokémon que lo usa. Recupera algunos PS en cada turno."
msgstr ""

#. nombre
#: data/moves/aquatail.tres
msgid "Acua Cola"
msgstr ""

#. descripción
#: data/moves/aquatail.tres
msgid "Ataca agitando la cola como si fuera una ola rabiosa en una tormenta devastadora."
msgstr ""

#. nombre
#: data/moves/assurance.tres
msgid "Buena Baza"
msgstr ""

#. descripción
#: data/moves/assurance.tres
msgid "Si el objetivo ya ha sufrido daño en ese turno, la fuerza del ataque se duplica."
msgstr ""

#. nombre
#: data/moves/astonish.tres
msgid "Impresionar"
msgstr ""

#. descripción
#: data/moves/astonish.tres
msgid "Lanza un grito tan tremendo que impresiona y puede amedrentar al objetivo."
msgstr ""

#. nombre
#: data/moves/attract.tres
msgid "Atracción"
msgstr ""

#. descripción
#: data/moves/attract.tres
msgid "Si el objetivo es del sexo opuesto, se enamorará y bajará la posibilidad de que ataque."
msgstr ""

#. nombre
#: data/moves/aurasphere.tres
msgid "Esfera Aural"
msgstr ""

#. descripción
#: data/moves/aurasphere.tres
msgid "Libera, desde su interior, una inmensa descarga de aura. Es infalible."
msgstr ""

#. nombre
#: data/moves/aurorabeam.tres
msgid "Rayo Aurora"
msgstr ""

#. descripción
#: data/moves/aurorabeam.tres
msgid "Rayo multicolor que puede reducir el Ataque."
msgstr ""

#. nombre
#: data/moves/auroraveil.tres
msgid "Velo Aurora"
msgstr ""

#. descripción
#: data/moves/auroraveil.tres
msgid "Reduce el daño de los ataques físicos y especiales que ejecuta el rival durante cinco turnos. Solo puede usarse cuando está granizando."
msgstr ""

#. nombre
#: data/moves/autotomize.tres
msgid "Aligerar"
msgstr ""

#. descripción
#: data/moves/autotomize.tres
msgid "El usuario se desprende de partes prescindibles de su cuerpo para hacerse más ligero y aumentar mucho su Velocidad."
msgstr ""

#. nombre
#: data/moves/avalanche.tres
msgid "Alud"
msgstr ""

#. descripción
#: data/moves/avalanche.tres
msgid "Este ataque inflige el doble de daño a un objetivo que haya golpeado al usuario en ese mismo turno."
msgstr ""

#. nombre
#: data/moves/axekick.tres
msgid "Patada Hacha"
msgstr ""

#. nombre
#: data/moves/babydolleyes.tres
msgid "Ojitos Tiernos"
msgstr ""

#. descripción
#: data/moves/babydolleyes.tres
msgid "Lanza una mirada al objetivo con ojos acaramelados, con lo que logra que su Ataque se reduzca. Este movimiento tiene prioridad alta."
msgstr ""

#. nombre
#: data/moves/barrage.tres
msgid "Bombardeo"
msgstr ""

#. descripción
#: data/moves/barrage.tres
#: data/moves/barrier.tres
#: data/moves/boneclub.tres
#: data/moves/bubble.tres
#: data/moves/captivate.tres
msgid "Este movimiento no se puede usar, por lo que sería mejor olvidarlo, aunque eso implique que no se pueda recordar posteriormente."
msgstr ""

#. nombre
#: data/moves/barrier.tres
msgid "Barrera"
msgstr ""

#. nombre
#: data/moves/beatup.tres
msgid "Paliza"
msgstr ""

#. descripción
#: data/moves/beatup.tres
msgid "Ataque de todo el equipo Pokémon. Cuantos más haya, más veces se atacará."
msgstr ""

#. nombre
#: data/moves/bellydrum.tres
msgid "Tambor"
msgstr ""

#. descripción
#: data/moves/bellydrum.tres
msgid "Reduce la mitad de los PS máximos para mejorar al máximo el Ataque."
msgstr ""

#. nombre
#: data/moves/bind.tres
msgid "Atadura"
msgstr ""

#. descripción
#: data/moves/bind.tres
msgid "Ata y oprime de cuatro a cinco turnos."
msgstr ""

#. nombre
#: data/moves/bite.tres
msgid "Mordisco"
msgstr ""

#. descripción
#: data/moves/bite.tres
msgid "Un voraz bocado que puede amedrentar al objetivo."
msgstr ""

#. nombre
#: data/moves/blastburn.tres
msgid "Anillo Ígneo"
msgstr ""

#. descripción
#: data/moves/blastburn.tres
msgid "Explosión de fuego. El atacante debe descansar el siguiente turno."
msgstr ""

#. nombre
#: data/moves/blazekick.tres
msgid "Patada Ígnea"
msgstr ""

#. descripción
#: data/moves/blazekick.tres
msgid "Patada que suele ser un golpe crítico y puede causar quemaduras."
msgstr ""

#. nombre
#: data/moves/blizzard.tres
msgid "Ventisca"
msgstr ""

#. descripción
#: data/moves/blizzard.tres
msgid "Tormenta de hielo que puede llegar a congelar."
msgstr ""

#. nombre
#: data/moves/bodypress.tres
msgid "Plancha Corporal"
msgstr ""

#. descripción
#: data/moves/bodypress.tres
msgid "El usuario usa el cuerpo para lanzar su ataque e infligir un daño directamente proporcional a su Defensa."
msgstr ""

#. nombre
#: data/moves/bodyslam.tres
msgid "Golpe Cuerpo"
msgstr ""

#. descripción
#: data/moves/bodyslam.tres
msgid "Salta sobre el objetivo con todo su peso y puede llegar a paralizarlo."
msgstr ""

#. nombre
#: data/moves/boneclub.tres
msgid "Hueso Palo"
msgstr ""

#. nombre
#: data/moves/bonemerang.tres
msgid "Huesomerang"
msgstr ""

#. descripción
#: data/moves/bonemerang.tres
msgid "Lanza un hueso a modo de bumerán que golpea dos veces."
msgstr ""

#. nombre
#: data/moves/bonerush.tres
msgid "Ataque Óseo"
msgstr ""

#. descripción
#: data/moves/bonerush.tres
msgid "Hueso en ristre, aporrea al objetivo de dos a cinco veces."
msgstr ""

#. nombre
#: data/moves/bounce.tres
msgid "Bote"
msgstr ""

#. descripción
#: data/moves/bounce.tres
msgid "El usuario bota en el primer turno y golpea al objetivo en el segundo y puede llegar a paralizarlo."
msgstr ""

#. nombre
#: data/moves/bravebird.tres
msgid "Pájaro Osado"
msgstr ""

#. descripción
#: data/moves/bravebird.tres
msgid "Pliega sus alas y ataca con un vuelo rasante. El Pokémon que lo usa también resulta seriamente dañado."
msgstr ""

#. nombre
#: data/moves/breakingswipe.tres
msgid "Vasto Impacto"
msgstr ""

#. descripción
#: data/moves/breakingswipe.tres
msgid "El usuario sacude violentamente su enorme cola para golpear a todos los rivales y reducir su Ataque a la par."
msgstr ""

#. nombre
#: data/moves/brickbreak.tres
msgid "Demolición"
msgstr ""

#. descripción
#: data/moves/brickbreak.tres
msgid "Potente ataque que también es capaz de destruir barreras como Pantalla de Luz y Reflejo."
msgstr ""

#. nombre
#: data/moves/brine.tres
msgid "Salmuera"
msgstr ""

#. descripción
#: data/moves/brine.tres
msgid "Si al objetivo le queda la mitad o menos de sus PS, el ataque será el doble de fuerte."
msgstr ""

#. nombre
#: data/moves/brutalswing.tres
msgid "Giro Vil"
msgstr ""

#. descripción
#: data/moves/brutalswing.tres
msgid "Hace pivotar su cuerpo para causar daño a su alrededor."
msgstr ""

#. nombre
#: data/moves/bubble.tres
msgid "Burbuja"
msgstr ""

#. nombre
#: data/moves/bubblebeam.tres
msgid "Rayo Burbuja"
msgstr ""

#. descripción
#: data/moves/bubblebeam.tres
msgid "Diluvio de burbujas que puede bajar la Velocidad."
msgstr ""

#. nombre
#: data/moves/bugbite.tres
msgid "Picadura"
msgstr ""

#. descripción
#: data/moves/bugbite.tres
msgid "Pica al objetivo. Si el objetivo lleva una baya, el usuario se la come y se beneficia de su efecto."
msgstr ""

#. nombre
#: data/moves/bugbuzz.tres
msgid "Zumbido"
msgstr ""

#. descripción
#: data/moves/bugbuzz.tres
msgid "El usuario crea una onda sónica dañina moviendo su cuerpo que también puede disminuir la Defensa Especial del objetivo."
msgstr ""

#. nombre
#: data/moves/bulkup.tres
msgid "Corpulencia"
msgstr ""

#. descripción
#: data/moves/bulkup.tres
msgid "Robustece el cuerpo para subir el Ataque y la Defensa."
msgstr ""

#. nombre
#: data/moves/bulldoze.tres
msgid "Terratemblor"
msgstr ""

#. descripción
#: data/moves/bulldoze.tres
msgid "Sacudida sísmica que afecta a los demás Pokémon adyacentes y también reduce su Velocidad."
msgstr ""

#. nombre
#: data/moves/bulletpunch.tres
msgid "Puño Bala"
msgstr ""

#. descripción
#: data/moves/bulletpunch.tres
msgid "Ataca con fuertes puñetazos tan rápidos como proyectiles. Este movimiento tiene prioridad alta."
msgstr ""

#. nombre
#: data/moves/bulletseed.tres
msgid "Semilladora"
msgstr ""

#. descripción
#: data/moves/bulletseed.tres
msgid "Dispara rápido de dos a cinco ráfagas de semillas de manera consecutiva."
msgstr ""

#. nombre
#: data/moves/burningjealousy.tres
msgid "Envidia Ardiente"
msgstr ""

#. descripción
#: data/moves/burningjealousy.tres
msgid "Ataca al objetivo con la energía generada por la envidia y causa quemaduras a los Pokémon cuyas características hayan aumentado en ese turno."
msgstr ""

#. nombre
#: data/moves/burnup.tres
msgid "Llama Final"
msgstr ""

#. descripción
#: data/moves/burnup.tres
msgid "Utiliza hasta el último resquicio de llamas de su cuerpo para infligir un grave daño al oponente. Tras el ataque, el usuario deja de ser de tipo Fuego."
msgstr ""

#. nombre
#: data/moves/calmmind.tres
msgid "Paz Mental"
msgstr ""

#. descripción
#: data/moves/calmmind.tres
msgid "Aumenta la concentración y calma el espíritu para subir el Ataque Especial y la Defensa Especial."
msgstr ""

#. nombre
#: data/moves/captivate.tres
msgid "Seducción"
msgstr ""

#. nombre
#: data/moves/charge.tres
msgid "Carga"
msgstr ""

#. descripción
#: data/moves/charge.tres
msgid "Recarga energía para potenciar el siguiente movimiento de tipo Eléctrico. También sube la Defensa Especial."
msgstr ""

#. nombre
#: data/moves/chargebeam.tres
msgid "Rayo Carga"
msgstr ""

#. descripción
#: data/moves/chargebeam.tres
msgid "Lanza un rayo eléctrico contra el objetivo. Puede subir el Ataque Especial de quien lo usa."
msgstr ""

#. nombre
#: data/moves/charm.tres
msgid "Encanto"
msgstr ""

#. descripción
#: data/moves/charm.tres
msgid "Engatusa al objetivo y reduce mucho su Ataque."
msgstr ""

#. nombre
#: data/moves/chillingwater.tres
msgid "Agua Fría"
msgstr ""

#. nombre
#: data/moves/chipaway.tres
msgid "Guardia Baja"
msgstr ""

#. nombre
#: data/moves/circlethrow.tres
msgid "Llave Giro"
msgstr ""

#. descripción
#: data/moves/circlethrow.tres
msgid "Lanza por los aires al objetivo y hace que salga otro Pokémon. Si es uno salvaje, acaba el combate."
msgstr ""

#. nombre
#: data/moves/clamp.tres
msgid "Tenaza"
msgstr ""

#. nombre
#: data/moves/clearsmog.tres
msgid "Niebla Clara"
msgstr ""

#. descripción
#: data/moves/clearsmog.tres
msgid "Ataca al objetivo con una singular bola de lodo que elimina cualquier cambio en sus características."
msgstr ""

#. nombre
#: data/moves/closecombat.tres
msgid "A Bocajarro"
msgstr ""

#. descripción
#: data/moves/closecombat.tres
msgid "Lucha abiertamente contra el objetivo sin protegerse. También reduce la Defensa y la Defensa Especial del usuario."
msgstr ""

#. nombre
#: data/moves/coaching.tres
msgid "Motivación"
msgstr ""

#. descripción
#: data/moves/coaching.tres
msgid "El usuario imparte indicaciones precisas a sus aliados, que ven aumentados su Ataque y su Defensa."
msgstr ""

#. nombre
#: data/moves/coil.tres
msgid "Enrosque"
msgstr ""

#. descripción
#: data/moves/coil.tres
msgid "El usuario se concentra, lo que le permite aumentar su Ataque, Defensa y Precisión."
msgstr ""

#. nombre
#: data/moves/cometpunch.tres
msgid "Puño Cometa"
msgstr ""

#. nombre
#: data/moves/confide.tres
msgid "Confidencia"
msgstr ""

#. descripción
#: data/moves/confide.tres
msgid "Hace que el objetivo pierda la concentración contándole un secreto. Disminuye el Ataque Especial del oponente."
msgstr ""

#. nombre
#: data/moves/confuseray.tres
msgid "Rayo Confuso"
msgstr ""

#. descripción
#: data/moves/confuseray.tres
msgid "Rayo siniestro que confunde al objetivo."
msgstr ""

#. nombre
#: data/moves/confusion.tres
msgid "Confusión"
msgstr ""

#. descripción
#: data/moves/confusion.tres
msgid "Débil ataque telequinético que puede causar confusión."
msgstr ""

#. nombre
#: data/moves/constrict.tres
msgid "Restricción"
msgstr ""

#. nombre
#: data/moves/cosmicpower.tres
msgid "Masa Cósmica"
msgstr ""

#. descripción
#: data/moves/cosmicpower.tres
msgid "Sube la Defensa y la Defensa Especial propias con energía mística."
msgstr ""

#. nombre
#: data/moves/covet.tres
msgid "Antojo"
msgstr ""

#. descripción
#: data/moves/covet.tres
msgid "Se acerca con ternura al objetivo, pero le ataca y le roba el objeto que lleve."
msgstr ""

#. nombre
#: data/moves/crabhammer.tres
msgid "Martillazo"
msgstr ""

#. descripción
#: data/moves/crabhammer.tres
msgid "Golpea con fuerza con una pinza enorme. Suele asestar un golpe crítico."
msgstr ""

#. nombre
#: data/moves/crosschop.tres
msgid "Tajo Cruzado"
msgstr ""

#. descripción
#: data/moves/crosschop.tres
msgid "Corte doble que suele propinar un golpe crítico."
msgstr ""

#. nombre
#: data/moves/crosspoison.tres
msgid "Veneno X"
msgstr ""

#. descripción
#: data/moves/crosspoison.tres
msgid "Tajo que puede envenenar al objetivo. Suele ser crítico."
msgstr ""

#. nombre
#: data/moves/crunch.tres
msgid "Triturar"
msgstr ""

#. descripción
#: data/moves/crunch.tres
msgid "Tritura con afilados colmillos y puede bajar la Defensa del objetivo."
msgstr ""

#. nombre
#: data/moves/crushclaw.tres
msgid "Garra Brutal"
msgstr ""

#. descripción
#: data/moves/crushclaw.tres
msgid "Hace trizas al objetivo con garras afiladas y puede bajar su Defensa."
msgstr ""

#. nombre
#: data/moves/curse.tres
msgid "Maldición"
msgstr ""

#. descripción
#: data/moves/curse.tres
msgid "Un movimiento que tiene efectos distintos si el usuario es de tipo Fantasma o no."
msgstr ""

#. nombre
#: data/moves/cut.tres
msgid "Corte"
msgstr ""

#. descripción
#: data/moves/cut.tres
msgid "Corta al adversario con garras, guadañas, etc."
msgstr ""

#. nombre
#: data/moves/darkestlariat.tres
msgid "Lariat Oscuro"
msgstr ""

#. descripción
#: data/moves/darkestlariat.tres
msgid "Gira sobre sí mismo y golpea al oponente con ambos brazos. Ignora los cambios en las características del objetivo."
msgstr ""

#. nombre
#: data/moves/darkpulse.tres
msgid "Pulso Umbrío"
msgstr ""

#. descripción
#: data/moves/darkpulse.tres
msgid "Libera una horrible aura llena de malos pensamientos que puede amedrentar al objetivo."
msgstr ""

#. nombre
#: data/moves/dazzlinggleam.tres
msgid "Brillo Mágico"
msgstr ""

#. descripción
#: data/moves/dazzlinggleam.tres
msgid "Inflige daño a los oponentes con una potente luz."
msgstr ""

#. nombre
#: data/moves/defensecurl.tres
msgid "Rizo Defensa"
msgstr ""

#. descripción
#: data/moves/defensecurl.tres
msgid "Se enrosca para ocultar sus puntos débiles y aumentar la Defensa."
msgstr ""

#. nombre
#: data/moves/defog.tres
msgid "Despejar"
msgstr ""

#. descripción
#: data/moves/defog.tres
msgid "Potente viento que barre el reflejo o la pantalla de luz creada por el objetivo. También puede reducir su Evasión."
msgstr ""

#. nombre
#: data/moves/destinybond.tres
msgid "Mismo Destino"
msgstr ""

#. descripción
#: data/moves/destinybond.tres
msgid "Si el usuario se debilita por un ataque rival antes de usar otro movimiento, el Pokémon rival se debilitará también. Puede fallar si se usa repetidamente."
msgstr ""

#. nombre
#: data/moves/detect.tres
msgid "Detección"
msgstr ""

#. descripción
#: data/moves/detect.tres
#: data/moves/protect.tres
msgid "Frena todos los ataques, pero puede fallar si se usa repetidamente."
msgstr ""

#. nombre
#: data/moves/dig.tres
msgid "Excavar"
msgstr ""

#. descripción
#: data/moves/dig.tres
msgid "El usuario cava durante el primer turno y ataca en el segundo."
msgstr ""

#. nombre
#: data/moves/disarmingvoice.tres
msgid "Voz Cautivadora"
msgstr ""

#. descripción
#: data/moves/disarmingvoice.tres
msgid "Obnubila a los oponentes con su fascinante voz y les provoca daños emocionales. Siempre acierta al objetivo."
msgstr ""

#. nombre
#: data/moves/discharge.tres
msgid "Chispazo"
msgstr ""

#. descripción
#: data/moves/discharge.tres
msgid "Una deslumbradora onda eléctrica afecta a los Pokémon que hay combatiendo alrededor. Puede paralizar."
msgstr ""

#. nombre
#: data/moves/dive.tres
msgid "Buceo"
msgstr ""

#. descripción
#: data/moves/dive.tres
msgid "El usuario se sumerge en el primer turno y ataca en el segundo."
msgstr ""

#. nombre
#: data/moves/dizzypunch.tres
msgid "Puño Mareo"
msgstr ""

#. nombre
#: data/moves/doubleedge.tres
msgid "Doble Filo"
msgstr ""

#. descripción
#: data/moves/doubleedge.tres
msgid "Ataque arriesgado que también hiere al agresor."
msgstr ""

#. nombre
#: data/moves/doublehit.tres
msgid "Doble Golpe"
msgstr ""

#. descripción
#: data/moves/doublehit.tres
msgid "Golpea al objetivo dos veces seguidas con la cola u otras partes de su cuerpo."
msgstr ""

#. nombre
#: data/moves/doublekick.tres
msgid "Doble Patada"
msgstr ""

#. descripción
#: data/moves/doublekick.tres
msgid "Una patada doble. Golpea dos veces."
msgstr ""

#. nombre
#: data/moves/doubleslap.tres
msgid "Doble Bofetón"
msgstr ""

#. nombre
#: data/moves/doubleteam.tres
msgid "Doble Equipo"
msgstr ""

#. descripción
#: data/moves/doubleteam.tres
msgid "Crea copias de sí mismo para mejorar la Evasión."
msgstr ""

#. nombre
#: data/moves/dracometeor.tres
msgid "Cometa Draco"
msgstr ""

#. descripción
#: data/moves/dracometeor.tres
msgid "Hace que grandes cometas caigan del cielo sobre el objetivo. Baja mucho el Ataque Especial del que lo usa."
msgstr ""

#. nombre
#: data/moves/dragonbreath.tres
msgid "Dragoaliento"
msgstr ""

#. descripción
#: data/moves/dragonbreath.tres
msgid "Poderosa ráfaga de aliento que golpea al objetivo y puede paralizarlo."
msgstr ""

#. nombre
#: data/moves/dragonclaw.tres
msgid "Garra Dragón"
msgstr ""

#. descripción
#: data/moves/dragonclaw.tres
msgid "Araña al objetivo con garras afiladas."
msgstr ""

#. nombre
#: data/moves/dragondance.tres
msgid "Danza Dragón"
msgstr ""

#. descripción
#: data/moves/dragondance.tres
