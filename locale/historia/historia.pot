#: data/story/capitulo1.json:pasos[0].titulo
#: data/story/capitulo1.json:pasos[6].titulo
msgid "Capítulo 1"
msgstr ""

#: data/story/capitulo1.json:pasos[0].subtitulo
msgid "Huellas en la niebla · Primera parte"
msgstr ""

#: data/story/capitulo1.json:pasos[1].lugar.nombre
msgid "Pueblo Lavanda"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[1].guion[0].narrar
msgid "Pueblo Lavanda. Han pasado muchos años desde que los grandes campeones recorrieron Kanto, pero la niebla sigue bajando cada mañana desde la Torre Pokémon."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[3].texto
msgid "¡Mamá, mira! Eevee ya aprendió Ataque Rápido. Bueno... casi."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[1].guion[7].texto
msgid "Qué Eevee tan bonito. ¿Es tuyo, cielo?"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[9].texto
msgid "...Sí, mamá. Me lo regaló papá. Hace dos años."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[1].guion[10].texto
msgid "Ah... claro. Claro que sí."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[14].texto
msgid "Cristina, ¿me ayudas a preparar el té de tu madre? Le gusta mirar la niebla un rato antes."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[17].texto
msgid "Papá... cada día se acuerda de menos cosas."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[18].texto
msgid "Hay días buenos y días malos. Hoy es de los malos, nada más."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[19].texto
msgid "Ayer se rió con tu Pidgey toda la tarde. ¿Te acuerdas? Eso también cuenta."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[23].texto
msgid "¡Pidgey! Ya vuela casi sin cojear. Cuando lo encontré con el ala rota pensé que no lo lograría."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[24].texto
msgid "Lo cuidaste todo el invierno. Tienes buena mano con los Pokémon."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[26].texto
msgid "Entonces déjame empezar mi viaje. Tengo quince años. ¡Mi hermano se fue a Johto con catorce!"
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[27].texto
msgid "Tu hermano se fue cuando tu madre estaba bien."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[29].texto
msgid "No puedo cuidarla a ella y además pasarme las noches preguntándome dónde estás tú."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[30].texto
msgid "¡Pero yo no soy una niña! Puedo cuidarme sola."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[31].texto
msgid "No es un no para siempre, Cristina. Es un no para ahora."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[1].guion[33].texto
msgid "Siempre es «ahora». Me voy a entrenar a la Ruta 8. ¡Ya verás que puedo!"
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[1].guion[41].texto
msgid "No te acerques a la niebla, cariño... Ahí es donde se pierden las cosas."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[1].guion[42].texto
msgid "...¿Qué has dicho, amor?"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[1].guion[44].narrar
msgid "Pero ella ya había vuelto a mirar hacia la Torre, en silencio."
msgstr ""

#: data/story/capitulo1.json:pasos[2].lugar.nombre
#: data/story/capitulo1.json:pasos[3].lugar.nombre
#: data/story/capitulo1.json:pasos[4].lugar.nombre
msgid "Ruta 8"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[2].guion[0].texto
msgid "Muy bien, equipo. ¡Otra vez! Eevee, Placaje contra ese tronco. Pidgey, desde arriba."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[2].guion[3].texto
msgid "Así... Así se hace. Si papá nos viera ahora..."
msgstr ""

#. Habla: Rufián
#: data/story/capitulo1.json:pasos[2].guion[8].texto
msgid "Vaya, vaya. Una entrenadora novata, solita en la Ruta 8."
msgstr ""

#. Habla: Rufiana
#: data/story/capitulo1.json:pasos[2].guion[9].texto
msgid "Mira ese Eevee. En Ciudad Azulona pagan muy bien por uno así de sano."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[2].guion[11].texto
msgid "¡No se acerquen!"
msgstr ""

#. Habla: Rufián
#: data/story/capitulo1.json:pasos[2].guion[12].texto
msgid "Tranquila, nadie tiene que salir herido. Danos al Eevee y la mochila, y te vas a casa."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[2].guion[14].texto
msgid "Ni lo sueñes. ¡Eevee, Pidgey, adelante!"
msgstr ""

#. Habla: Rufiana
#: data/story/capitulo1.json:pasos[2].guion[15].texto
msgid "Como quieras, niña. ¡A por ellos!"
msgstr ""

#: data/story/capitulo1.json:pasos[3].rival
msgid "¡Los rufianes de la Ruta 8 atacan!"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[3].eventos[0].antes[0].narrar
msgid "De pronto, una sombra se alarga sobre la hierba, aunque no hay nada que pueda proyectarla..."
msgstr ""

#. Habla: Rufián
#: data/story/capitulo1.json:pasos[3].eventos[0].guion[0].texto
msgid "¿¡Un Gengar!? ¿De dónde ha salido eso?"
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[3].eventos[0].guion[1].texto
msgid "No son palabras. Es una sensación cálida y firme, como una mano en el hombro: «No tengas miedo. Estoy contigo»."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[3].eventos[0].guion[2].texto
msgid "¿Tú... me estás ayudando?"
msgstr ""

#. Habla: Rufiana
#: data/story/capitulo1.json:pasos[4].guion[0].texto
msgid "¡Esto no se queda así, niña!"
msgstr ""

#. Habla: Rufián
#: data/story/capitulo1.json:pasos[4].guion[1].texto
msgid "¡Corre, corre! ¡Ese bicho no es normal!"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[6].texto
msgid "Se fueron... Gracias. De verdad."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[7].texto
msgid "Pero ¿por qué me ayudaste? Los Gengar no suelen acercarse a la gente."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[4].guion[8].texto
msgid "Una nostalgia enorme, de esas que aprietan el pecho. Y debajo, algo parecido a un reconocimiento."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[10].texto
msgid "¿Me... conoces?"
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[4].guion[12].texto
msgid "Ganas de ir hacia allí. Hacia Lavanda."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[13].texto
msgid "Ese es el camino a mi casa."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[15].texto
msgid "¿Quieres venir conmigo? Supongo que papá va a gritar un poco..."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[4].guion[18].texto
msgid "Lo tomaré como un sí."
msgstr ""

#: data/story/capitulo1.json:pasos[5].lugar.nombre
msgid "Pueblo Lavanda · Al atardecer"
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[5].guion[5].texto
msgid "¡Cristina! ¿Dónde estabas? ...¿Qué es eso? ¡Apártate de ese Gengar!"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[5].guion[6].texto
msgid "¡Espera, papá! Me salvó. Unos rufianes intentaron robarme a Eevee en la Ruta 8 y él apareció de la nada."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[5].guion[7].texto
msgid "¿Rufianes? ¿Estás bien? ¿Te hicieron algo?"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[5].guion[8].texto
msgid "Estoy bien. Gracias a él."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[5].guion[15].texto
msgid "Todo se detiene. Una alegría tan grande que duele... y miedo. Miedo de que ella no lo recuerde."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[5].guion[18].texto
msgid "...¿Eres tú?"
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[5].guion[19].texto
msgid "¿Amor?"
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[5].guion[20].texto
msgid "Esos ojos... Yo conozco esos ojos. Tú estabas... estabas en la Torre, con ella..."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[5].guion[22].texto
msgid "¿Con quién, mamá? ¿De qué estás hablando?"
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[5].guion[25].texto
msgid "¿Cristina? ¿Qué hace este Pokémon en el jardín? Vamos a asustar a los vecinos..."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[5].guion[27].texto
msgid "Tristeza. Una tristeza vieja y cansada, como la de quien lleva mucho tiempo esperando."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[5].guion[33].texto
msgid "Cristina... entra. Y trae a tu amigo."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[5].guion[34].texto
msgid "Hay cosas de tu madre que nunca te conté. Creo que ya es hora."
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[5].guion[36].narrar
msgid "Fin de la primera parte del Capítulo 1."
msgstr ""

#: data/story/capitulo1.json:pasos[6].subtitulo
msgid "Huellas en la niebla · Segunda parte"
msgstr ""

#: data/story/capitulo1.json:pasos[7].lugar.nombre
msgid "Casa de Cristina · Esa noche"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[7].guion[0].narrar
msgid "Esa noche, cuando su madre por fin se quedó dormida, el padre de Cristina preparó dos tazas de té y se sentó frente a ella."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[1].texto
msgid "Tu madre era entrenadora, Cristina. Y por lo que dicen, de las mejores."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[7].guion[3].texto
msgid "¿Mamá? Pero si nunca... Ni siquiera tiene Pokémon."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[4].texto
msgid "Cuando llegué a Lavanda, los mayores del pueblo todavía hablaban de ella. Una chica que subía sola a la Torre de noche y que no perdía un combate."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[5].texto
msgid "Si ese Gengar la reconoce, tuvo que conocerla en esa época. Antes de que yo apareciera."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[7].guion[7].texto
msgid "Una calidez antigua. Noches en la Torre. Pasos que suben la escalera, uno detrás de otro."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[7].guion[8].texto
msgid "¿Y por qué lo dejó?"
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[9].texto
msgid "No lo sé. Cuando la conocí ya no entrenaba, y nunca quiso hablar de esos años. Nunca."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[10].texto
msgid "Lo único que nombró alguna vez fue a una amiga. «La mejor amiga que tuve», decía. Y se le perdía la mirada."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[16].texto
msgid "Guardaba esto en el fondo del armario. La encontré cuando nos mudamos."
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[7].guion[17].narrar
msgid "Es una fotografía vieja, doblada por las esquinas. Dos chicas sonríen frente a la Torre Pokémon. Una es su madre, con quince o dieciséis años. La otra tiene la cara medio borrada por una mancha de humedad."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[7].guion[21].texto
msgid "Un vuelco. Conoce a las dos. Y debajo, una pena tan honda que Cristina tiene que apartar la mirada."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[7].guion[23].texto
msgid "Gengar... ¿también la conoces a ella? ¿Quién es?"
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[7].guion[24].texto
msgid "Silencio. No es que no quiera contarlo: es que no sabe cómo."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[7].guion[26].texto
msgid "Papá. Quiero saber quién fue mamá. Quién es esa chica. Qué pasó en la Torre."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[7].guion[27].texto
msgid "Si ella ya no puede contármelo... lo voy a descubrir yo."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[28].texto
msgid "Cristina..."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[7].guion[29].texto
msgid "Lo sé. Lo sé. Pero no esta noche."
msgstr ""

#: data/story/capitulo1.json:pasos[8].lugar.nombre
msgid "Pueblo Lavanda · A la mañana siguiente"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[8].guion[0].narrar
msgid "A la mañana siguiente, Cristina se levanta antes que nadie."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[1].texto
msgid "Venga, contesta... Contesta..."
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[4].texto
msgid "¿Cris? ¿Sabes qué hora es? Aquí es la misma que allí, pero yo estaba durmiendo."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[5].texto
msgid "Necesito tu ayuda."
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[6].texto
msgid "Eso ya lo veo. Tienes la misma cara que cuando escondiste mis medallas debajo de la cama."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[7].texto
msgid "Quiero empezar mi viaje y papá no me deja. Y anoche me contó cosas de mamá... Era entrenadora. Una de las mejores. ¿Tú lo sabías?"
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[8].texto
msgid "...No. Nunca nos dijo nada. ¿Mamá?"
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[9].texto
msgid "Espera. ¿Eso que tienes detrás es un Gengar?"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[11].texto
msgid "Me salvó de unos rufianes en la Ruta 8. Conoce a mamá, estoy segura. Y creo que sabe qué pasó."
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[12].texto
msgid "...Vale. Pásame con papá."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[8].guion[15].texto
msgid "¿Con quién hablas tan temprano?"
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[16].texto
msgid "Hola, papá."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[8].guion[17].texto
msgid "¡Hijo! ¿Pasa algo? ¿Estás bien?"
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[18].texto
msgid "Estoy bien. Escucha. Cuando me fui de casa, mamá me dijo una cosa en la puerta: «Lo que importa no se encuentra quedándose quieto»."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[8].guion[20].texto
msgid "...Sí. Eso decía."
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[21].texto
msgid "Cris ya no es una niña. Y no va a ir sola: tiene a Eevee, a Pidgey... y a un Gengar bastante raro, por lo que veo."
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[22].texto
msgid "Papá, si mamá pudiera elegir, ¿qué crees que diría?"
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[8].guion[25].texto
msgid "Diría que sí. Lo diría sin pensarlo dos veces."
msgstr ""

#. Habla: Papá
#: data/story/capitulo1.json:pasos[8].guion[27].texto
msgid "Está bien, Cristina. Con una condición: me llamas cada noche. Cada noche."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[30].texto
msgid "¡Gracias, papá! ¡Te llamaré todas las noches, te lo prometo!"
msgstr ""

#. Habla: Hermano
#: data/story/capitulo1.json:pasos[8].guion[31].texto
msgid "Y a mí también. Quiero saber todo lo que descubras."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[8].guion[36].texto
msgid "¿Te vas de viaje, cielo?"
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[8].guion[37].texto
msgid "Sí, mamá."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[8].guion[38].texto
msgid "Abrígate. La niebla de la Ruta 12 es muy fría por las mañanas."
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[8].guion[40].narrar
msgid "Su madre nunca había hablado de la Ruta 12."
msgstr ""

#. Habla: Mamá
#: data/story/capitulo1.json:pasos[8].guion[42].texto
msgid "Y cuida bien de él."
msgstr ""

#: data/story/capitulo1.json:pasos[9].lugar.nombre
#: data/story/capitulo1.json:pasos[10].lugar.nombre
#: data/story/capitulo1.json:pasos[11].lugar.nombre
msgid "Ruta 12"
msgstr ""

#. Narración
#: data/story/capitulo1.json:pasos[9].guion[0].narrar
msgid "Ruta 12. Al sur de Lavanda, el camino bordea el mar hasta Ciudad Fucsia."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[9].guion[1].texto
msgid "Bueno, equipo. Primera parada: Ciudad Fucsia."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[9].guion[2].texto
msgid "No sé qué vamos a encontrar, pero... lo vamos a hacer juntos."
msgstr ""

#. Lo que siente Gengar
#: data/story/capitulo1.json:pasos[9].guion[3].texto
msgid "Inquietud. Algo se mueve cerca del agua."
msgstr ""

#. Habla: Cristina
#: data/story/capitulo1.json:pasos[9].guion[9].texto
msgid "¡Pokémon salvajes! Eevee, Pidgey, ¡preparaos! Gengar... ¿nos echas una mano otra vez?"
msgstr ""

#: data/story/capitulo1.json:pasos[10].rival
